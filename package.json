{
  "name": "nat-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "catalog:pdf": "tsx scripts/export-catalog.ts && cd ingest && uv run python -m nat_ingest.ecatalog --all",
    "crawl:practika": "tsx scripts/crawl-practika.ts",
    "dev:customer": "SITE_VARIANT=customer next dev",
    "start:customer": "SITE_VARIANT=customer next start",
    "embed:images": "tsx scripts/embed-images.ts",
    "db:materials": "tsx scripts/update-materials.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.24.0"
}
