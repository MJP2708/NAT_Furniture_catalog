# secrets
.env*
.neon

# python ingest tooling (regenerable)
ingest/.venv/
ingest/.cache/
__pycache__/
*.pyc

# generated images live in Neon Object Storage (nat_ingest.upload); the site serves them via /media/[...path]
public/media/
# catalogue PDFs are uploaded to the bucket (catalogue/...) by nat_ingest.upload
public/e-catalogue*.pdf

# node / next.js
/node_modules
/.next/
/out/
/coverage
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.pem
.pnpm-debug.log*
